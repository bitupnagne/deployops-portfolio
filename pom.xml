<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <relativePath/>
    </parent>

    <groupId>com.portfolio</groupId>
    <artifactId>deploy-ops</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>DeployOps</name>
    <description>portfolio 내부 배포 관리 시스템</description>

    <properties>
        <java.version>21</java.version>
        <deploy.embedded.exclude>application-install.yml</deploy.embedded.exclude>
    </properties>

    <dependencies>
        <!-- Web + Thymeleaf -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- Security -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.thymeleaf.extras</groupId>
            <artifactId>thymeleaf-extras-springsecurity6</artifactId>
        </dependency>

        <!-- MyBatis + MariaDB -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>4.0.1</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-commons</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway DB migration (replaces spring.sql.init schema.sql; fixes schema drift) -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <!-- Spring Boot 4.0: Flyway 자동설정은 별도 모듈(autoconfigure 분리). 없으면 Flyway 미실행. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- QR 코드 생성(OTP 등록 화면). 빌드시 fat jar에 포함되어 폐쇄망 런타임에 외부의존 없음.
             PNG 렌더는 JDK 내장 ImageIO 사용(별도 javase 모듈 불필요). -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>3.5.3</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- DevTools (개발 시 템플릿/정적 파일 자동 반영) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.2.224</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>embedded-config</id>
            <properties>
                <deploy.config.directory>${project.basedir}/config/private</deploy.config.directory>
                <deploy.embedded.exclude>__no_embedded_config_exclusion__</deploy.embedded.exclude>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions><execution>
                            <id>copy-private-config-after-tests</id>
                            <phase>prepare-package</phase>
                            <goals><goal>copy-resources</goal></goals>
                            <configuration>
                                <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                                <resources>
                                    <resource>
                                        <directory>${deploy.config.directory}</directory>
                                        <filtering>false</filtering>
                                        <includes><include>application-install.yml</include></includes>
                                    </resource>
                                </resources>
                            </configuration>
                        </execution></executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <executions><execution>
                            <id>require-embedded-config</id>
                            <goals><goal>enforce</goal></goals>
                            <configuration><rules><requireFilesExist><files>
                                <file>${deploy.config.directory}/application-install.yml</file>
                            </files></requireFilesExist></rules></configuration>
                        </execution></executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions><execution>
                    <id>copy-maintenance-code-after-tests</id>
                    <phase>prepare-package</phase>
                    <goals><goal>copy-resources</goal></goals>
                    <configuration>
                        <outputDirectory>${project.build.outputDirectory}/deploy-maintenance/v1</outputDirectory>
                        <resources><resource>
                            <directory>installer</directory><filtering>false</filtering>
                            <includes>
                                <include>deploy-system/maintenance-payload.json</include>
                                <include>deploy-system/maintenance.py</include>
                                <include>deploy-system/embedded-config.py</include>
                                <include>deploy-system/deployops-backup.sh</include>
                                <include>deploy-system/patch-deployops.sh</include>
                                <include>deploy-system/install-tls-keystore.py</include>
                                <include>deploy-system/deployops-state.py</include>
                                <include>nexus-backup/nexus-local-backup-restore.py</include>
                                <include>nexus-backup/nexus-isolated-restore-worker.py</include>
                                <include>nexus-backup/nexus-promotion-worker.py</include>
                                <include>nexus-backup/nexus-backup-broker.py</include>
                                <include>nexus-backup/deployops-nexus-backup.service</include>
                                <include>nexus-backup/deployops-nexus-backup.timer</include>
                            </includes>
                        </resource></resources>
                    </configuration>
                </execution></executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <executions><execution>
                    <id>remove-private-build-resources-before-tests</id>
                    <phase>initialize</phase>
                    <goals><goal>clean</goal></goals>
                    <configuration>
                        <excludeDefaultDirectories>true</excludeDefaultDirectories>
                        <failOnError>true</failOnError>
                        <filesets><fileset>
                            <directory>${project.build.outputDirectory}</directory>
                            <followSymlinks>false</followSymlinks>
                            <includes>
                                <include>application-install.yml</include>
                                <include>deploy-maintenance/**</include>
                            </includes>
                        </fileset></filesets>
                    </configuration>
                </execution></executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>21</release>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-java</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                    <message>Java 21 이상이 필요합니다. JAVA_HOME을 확인하세요.</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>.work/**</exclude>
                        <exclude>**/.work/**</exclude>
                        <exclude>${deploy.embedded.exclude}</exclude>
                    </excludes>
                    <forceCreation>true</forceCreation>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
