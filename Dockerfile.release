ARG RUNTIME_BASE_IMAGE
FROM ${RUNTIME_BASE_IMAGE}
USER root
WORKDIR /app
ARG JAR_SHA256
COPY target/*.jar /app/app.jar
RUN test "${#JAR_SHA256}" -eq 64 \
    && printf '%s  /app/app.jar\n' "$JAR_SHA256" | sha256sum -c - \
    && java -version 2>&1 | grep -Eq 'version "21[.]'
RUN install -d -o 10001 -g 10001 -m 0700 /home/deployops /home/deployops/.deployops /home/deployops/.deployops/nginx-uploads
USER 10001:10001
EXPOSE 9090
ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0"
ENV NGINX_UPLOAD_DIR="/home/deployops/.deployops/nginx-uploads"
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]
